# =============================================================================
# ANGALY — Web — Variables d'environnement (développement local)
# Copier ce fichier en .env.local (dans apps/web/) et remplir les valeurs.
# =============================================================================

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

NEXT_PUBLIC_API_URL="http://localhost:3003/api"
NEXT_PUBLIC_WS_URL="ws://localhost:3003"
# URL interne serveur (Next.js → NestJS direct) — utilisée par NextAuth authorize()
API_INTERNAL_URL="http://localhost:3003/api"

# Google Maps Platform (Maps JavaScript API / Advanced Markers) pour la carte des ateliers
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
