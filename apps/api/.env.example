# =============================================================================
# ANGALY — API — Variables d'environnement (développement local)
# Copier ce fichier en .env (dans apps/api/) et remplir les valeurs.
# =============================================================================

DATABASE_URL="postgresql://angaly_user:angaly_pass@localhost:5432/angaly_dev"

JWT_PRIVATE_KEY_BASE64="..."
JWT_PUBLIC_KEY_BASE64="..."
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_TIMEOUT_MS=15000
# Photo analysis (vision model): 20–60 s with Opus; default 90000
AI_SERVICE_VISION_TIMEOUT_MS=90000

# Realistic render (cloth-sim worker, docs/features/realistic-render-blender.md). Empty token = worker endpoints off.
CLOTH_SIM_WORKER_TOKEN=""
CLOTH_SIM_MAX_PER_DAY=10
CLOTH_SIM_TIMEOUT_S=600

MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="angaly_minio"
MINIO_SECRET_KEY="changeme-minio-root-password"
MINIO_PUBLIC_URL="http://localhost:9000"

NODE_ENV="development"
API_PORT=3003
API_CORS_ORIGINS="http://localhost:3001"

# Notifications — canal email (module `notifications`). Vide = canal email
# désactivé (in-app seule) — voir docs/features/notifications.md.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ANGALY <no-reply@angaly.mg>"
