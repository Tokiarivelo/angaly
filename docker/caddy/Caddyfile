# ANGALY — Caddy local HTTPS reverse proxy (optional, dev only)
#
# Setup:
#   echo "127.0.0.1 angaly.local" | sudo tee -a /etc/hosts
#   docker compose -f docker-compose.caddy.yml up -d
#
# Access: https://angaly.local (Caddy generates + trusts a local CA cert)
#
# Architecture:
#   https://angaly.local/           → Next.js  host.docker.internal:3000
#   https://angaly.local/api/auth/* → Next.js  host.docker.internal:3000 (NextAuth)
#   https://angaly.local/api/*      → NestJS   host.docker.internal:3001
#   https://angaly.local/docs       → NestJS   host.docker.internal:3001 (Swagger, dev only)

{
  admin localhost:2019
}

angaly.local {
  tls internal

  handle /api/auth/* {
    reverse_proxy host.docker.internal:3000 {
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  handle /api/* {
    reverse_proxy host.docker.internal:3001
  }

  handle /docs* {
    reverse_proxy host.docker.internal:3001
  }

  handle {
    reverse_proxy host.docker.internal:3000 {
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
}
