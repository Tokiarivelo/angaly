{
  "name": "@angaly/database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate 2>/dev/null || true",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e ../../.env.prod -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force"
  },
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "dependencies": {
    "@angaly/storage": "workspace:*",
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "exports": {
    ".": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    },
    "./client": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    }
  }
}
