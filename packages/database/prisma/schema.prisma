// ANGALY — Prisma Schema
// PostgreSQL 16
// Translates docs/specifications/ANGALY_Specifications_Completes.md §96/§97 into the DB layer.
// Naming/style mirrors the reference monorepo (SIRH): cuid ids, snake_case tables via @@map,
// indexed FKs/lookups, enums mirrored 1:1 into packages/types.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
}

// ============================================================
// Enums
// ============================================================

/// Spec §68 — Visiteur is not persisted (public, unauthenticated).
enum Role {
  CLIENT
  COUTURIERE
  MANAGER
  ADMIN
}

enum CategoryKind {
  CREATION
  PRODUCT
  BLOG
}

enum CreationAvailability {
  DISPONIBLE
  SUR_DEMANDE
  PIECE_UNIQUE
}

enum ProductAvailability {
  AVAILABLE
  LAST_PIECE
  OUT_OF_STOCK
  ON_ORDER
  RESERVED
}

enum AppointmentType {
  ROBE_MARIEE
  COSTUME
  ROBE_SOIREE
  RETOUCHE
  PATRON
  CONSULTATION
  ESSAYAGE
}

/// Spec §97
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Spec §97
enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

/// Spec §97
enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MeasurementUnit {
  CM
  INCH
}

/// Spec §97
enum PatternStatus {
  DRAFT
  GENERATING
  GENERATED
  REVIEW_REQUIRED
  CORRECTION_REQUIRED
  VALIDATED
  EXPORTED
  ARCHIVED
}

enum PatternExportFormat {
  PDF_A4
  PDF_A3
  PDF_A0
  SVG
  DXF
}

enum AIConversationRole {
  USER
  ASSISTANT
}

/// Which apps/ai-service backend handles measurement estimation — admin-controlled
/// (docs/features/ai-model-settings.md). LOCAL_STATISTICAL falls back to GEMINI at
/// the ai-service layer if its trained artifact isn't loaded.
enum AiMeasurementModel {
  GEMINI
  LOCAL_STATISTICAL
}

enum FavoriteEntityType {
  CREATION
  PRODUCT
  COLLECTION
}

/// Discriminator for the polymorphic Media attachment (spec §76 storage folders).
enum MediaEntityType {
  CREATION
  PRODUCT
  PRODUCT_VARIANT
  COLLECTION
  ATELIER
  CUSTOMER_AVATAR
  PATTERN_EXPORT
  BLOG_POST
  PAGE_SECTION
  QUOTE_DOCUMENT
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  ORDER_STATUS_CHANGED
  QUOTE_RECEIVED
  PATTERN_STATUS_CHANGED
  MESSAGE_RECEIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum Locale {
  FR
  MG
}

// ============================================================
// Identity
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CLIENT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer          Customer?
  assignedAppointments Appointment[]      @relation("AppointmentAssignee")
  reviewedPatternVersions PatternVersion[] @relation("PatternVersionReviewer")
  uploadedMedia     Media[]
  pageSectionEdits  PageSectionVersion[]
  blogPosts         BlogPost[]
  notifications     Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  aiModelSettingEdits AiModelSetting[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// One row per issued refresh token (rotation-friendly: the old row is
/// revoked, not deleted, when a new token is issued — see docs/features/auth.md).
/// Only the SHA-256 hash is stored, never the raw token.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Single-use, time-limited password reset token. Only the SHA-256 hash is
/// stored — the raw token is emailed to the user and never persisted.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  orders              Order[]
  quotes              Quote[]
  measurementProfiles MeasurementProfile[]
  patternProjects     PatternProject[]
  favorites           Favorite[]
  reviews             Review[]
  aiConversations     AIConversation[]
  conversations       Conversation[]

  @@index([lastName, firstName])
  @@map("customers")
}

// ============================================================
// Maison — Ateliers, Créations, Collections, Catégories
// ============================================================

model Atelier {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  address          String
  city             String
  phone            String?
  openingHoursJson Json
  servicesJson     Json?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments  Appointment[]
  products      Product[]
  media         Media[]        @relation("AtelierMedia")
  conversations Conversation[]

  @@map("ateliers")
}

model Category {
  id   String       @id @default(cuid())
  slug String       @unique
  name String
  kind CategoryKind

  creations Creation[]
  products  Product[]
  blogPosts BlogPost[]

  @@index([kind])
  @@map("categories")
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  story       String?
  seasonYear  Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creations Creation[]
  media     Media[]    @relation("CollectionMedia")

  @@map("collections")
}

model Creation {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  categoryId    String
  collectionId  String?
  description   String
  genre         String?
  type          String?
  color         String?
  style         String?
  materials     String?
  techniques    String?
  availability  CreationAvailability @default(DISPONIBLE)
  reproducible  Boolean              @default(true)
  isFeatured    Boolean              @default(false)
  featuredFrom  DateTime?
  featuredUntil DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  collection Collection? @relation(fields: [collectionId], references: [id])
  media      Media[]     @relation("CreationMedia")
  favorites  Favorite[]
  quotes     Quote[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([isFeatured])
  @@index([genre])
  @@index([type])
  @@index([color])
  @@index([style])
  @@map("creations")
}

// ============================================================
// Prêt-à-porter — Produits, variantes, stock
// ============================================================

model Product {
  id          String              @id @default(cuid())
  sku         String              @unique
  slug        String              @unique
  name        String
  categoryId  String
  atelierId   String?
  description String
  price       Decimal             @db.Decimal(12, 2)
  currency    String              @default("MGA")
  status      ProductAvailability @default(AVAILABLE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  category Category        @relation(fields: [categoryId], references: [id])
  atelier  Atelier?        @relation(fields: [atelierId], references: [id])
  variants ProductVariant[]
  media    Media[]         @relation("ProductMedia")
  favorites Favorite[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  sku           String  @unique
  size          String
  color         String
  material      String?
  priceOverride Decimal? @db.Decimal(12, 2)

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  orderItems OrderItem[]
  // Colorway-specific photos (e.g. the "Navy" swatch shows the navy photos) —
  // optional: a variant with none falls back to the product's shared media.
  media     Media[]     @relation("ProductVariantMedia")

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id                 String @id @default(cuid())
  variantId          String @unique
  quantityAvailable  Int    @default(0)
  quantityReserved   Int    @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

// ============================================================
// Rendez-vous
// ============================================================

model Appointment {
  id              String            @id @default(cuid())
  reference       String            @unique
  customerId      String?
  firstName       String
  lastName        String
  phone           String
  email           String
  type            AppointmentType
  atelierId       String
  assignedToId    String?
  scheduledAt     DateTime
  durationMinutes Int               @default(45)
  status          AppointmentStatus @default(PENDING)
  message         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer   Customer? @relation(fields: [customerId], references: [id])
  atelier    Atelier   @relation(fields: [atelierId], references: [id])
  assignedTo User?     @relation("AppointmentAssignee", fields: [assignedToId], references: [id])

  @@index([atelierId, scheduledAt])
  @@index([customerId])
  @@index([status])
  @@map("appointments")
}

// ============================================================
// Commandes, paiements
// ============================================================

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  customerId          String
  status              OrderStatus @default(PENDING)
  subtotal            Decimal     @db.Decimal(12, 2)
  shippingCost        Decimal     @default(0) @db.Decimal(12, 2)
  total               Decimal     @db.Decimal(12, 2)
  currency            String      @default("MGA")
  shippingAddressJson Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  transactionRef String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// ============================================================
// Devis (sur-mesure)
// ============================================================

model Quote {
  id                  String      @id @default(cuid())
  quoteNumber         String      @unique
  customerId          String
  creationId          String?
  description         String
  lineItemsJson        Json
  subtotal            Decimal     @db.Decimal(12, 2)
  depositAmount       Decimal     @db.Decimal(12, 2)
  balanceAmount       Decimal     @db.Decimal(12, 2)
  total               Decimal     @db.Decimal(12, 2)
  status              QuoteStatus @default(DRAFT)
  validUntil          DateTime?
  estimatedDelayDays  Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  creation Creation? @relation(fields: [creationId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

// ============================================================
// Mesures
// ============================================================

model MeasurementProfile {
  id        String          @id @default(cuid())
  customerId String
  label     String
  unit      MeasurementUnit @default(CM)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  values         Measurement[]
  patternProjects PatternProject[]

  @@index([customerId])
  @@map("measurement_profiles")
}

/// One row per measurement key (e.g. TOUR_POITRINE) within a profile.
model Measurement {
  id        String @id @default(cuid())
  profileId String
  key       String
  valueCm   Float

  profile MeasurementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@map("measurements")
}

// ============================================================
// Angaly Pattern Studio (Premium)
// ============================================================

model PatternProject {
  id                   String        @id @default(cuid())
  projectRef           String        @unique // e.g. ANG-PAT-2026-00001
  customerId           String
  measurementProfileId String?
  garmentType          String
  occasion             String?
  style                String?
  cutType              String?
  detailsJson          Json?
  inspirationMediaId   String?
  status               PatternStatus @default(DRAFT)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id])
  measurementProfile MeasurementProfile? @relation(fields: [measurementProfileId], references: [id])
  inspirationMedia   Media?              @relation("PatternInspirationMedia", fields: [inspirationMediaId], references: [id])
  versions           PatternVersion[]
  aiConversations    AIConversation[]

  @@index([customerId])
  @@index([status])
  @@map("pattern_projects")
}

model PatternVersion {
  id             String   @id @default(cuid())
  projectId      String
  versionNumber  Int
  changeLabel    String?
  parametersJson Json
  generatedByAI  Boolean  @default(false)
  reviewedById   String?
  reviewNote     String?
  createdAt      DateTime @default(now())

  project    PatternProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("PatternVersionReviewer", fields: [reviewedById], references: [id])
  pieces     PatternPiece[]
  exports    PatternExport[]

  @@unique([projectId, versionNumber])
  @@map("pattern_versions")
}

model PatternPiece {
  id                  String   @id @default(cuid())
  versionId           String
  name                String
  dimensionsJson      Json
  fabricRecommendation String?
  quantity            Int      @default(1)
  grainlineJson       Json?
  seamAllowanceCm     Float?
  notchesJson         Json?

  version PatternVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("pattern_pieces")
}

model PatternExport {
  id        String              @id @default(cuid())
  versionId String
  format    PatternExportFormat
  mediaId   String
  createdAt DateTime            @default(now())

  version PatternVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  media   Media          @relation("PatternExportMedia", fields: [mediaId], references: [id])

  @@index([versionId])
  @@map("pattern_exports")
}

/// History of the AI assistant conversation for a customer and/or a pattern project (spec §31).
model AIConversation {
  id               String              @id @default(cuid())
  customerId       String?
  patternProjectId String?
  role             AIConversationRole
  message          String
  createdAt        DateTime            @default(now())

  customer       Customer?       @relation(fields: [customerId], references: [id])
  patternProject PatternProject? @relation(fields: [patternProjectId], references: [id])

  @@index([customerId])
  @@index([patternProjectId])
  @@map("ai_conversations")
}

/// Singleton row (fixed id "singleton") — admin-controlled choice of AI backend
/// for measurement estimation. Read by `ai-inference` on every generation that
/// needs to estimate missing measurements; written only via the ADMIN-only
/// `/admin/ai-settings` endpoint. See docs/features/ai-model-settings.md.
model AiModelSetting {
  id                String             @id @default("singleton")
  measurementModel  AiMeasurementModel @default(GEMINI)
  updatedById       String?
  updatedAt         DateTime           @updatedAt
  createdAt         DateTime           @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("ai_model_settings")
}

// ============================================================
// Avis, témoignages, blog
// ============================================================

model Review {
  id         String   @id @default(cuid())
  customerId String
  productId  String?
  rating     Int
  comment    String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model Testimonial {
  id            String   @id @default(cuid())
  customerName  String
  creationLabel String?
  quote         String
  isVerified    Boolean  @default(false)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  media Media[] @relation("TestimonialMedia")

  @@map("testimonials")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  categoryId  String
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])
  media    Media[]  @relation("BlogPostMedia")

  @@index([categoryId])
  @@index([publishedAt])
  @@map("blog_posts")
}

// ============================================================
// Favoris, notifications
// ============================================================

model Favorite {
  id         String             @id @default(cuid())
  customerId String
  entityType FavoriteEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creation   Creation?   @relation(fields: [entityId], references: [id], map: "favorites_creation_fkey")
  product    Product?    @relation(fields: [entityId], references: [id], map: "favorites_product_fkey")

  @@unique([customerId, entityType, entityId])
  @@map("favorites")
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  type             NotificationType
  title            String
  body             String
  isRead           Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId  String?
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================================
// Messagerie client ↔ atelier
// ============================================================

/// One conversation per (Customer, Atelier) pair — the simplest model that
/// still supports "start a new thread with an atelier" without a full
/// ticketing system: `send-message` finds-or-creates by that pair (see
/// docs/features/messages.md). `relatedEntityType`/`relatedEntityId` mirror
/// `Notification`'s generic link (order/quote/appointment that prompted the
/// conversation) rather than a hard FK to every possible entity — set once,
/// on first creation, and not overwritten by later messages on the same
/// thread.
model Conversation {
  id                 String   @id @default(cuid())
  customerId         String
  atelierId          String
  relatedEntityType  String?
  relatedEntityId    String?
  lastMessagePreview String
  lastMessageAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  atelier  Atelier   @relation(fields: [atelierId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([customerId, atelierId])
  @@index([customerId, lastMessageAt])
  @@map("conversations")
}

enum MessageSenderRole {
  CLIENT
  STAFF
}

/// `isRead` tracks the *client's* read state for the thread: `true` for
/// CLIENT-authored messages (nothing to read back), `false` for STAFF-authored
/// messages until the client opens the thread (`get-conversation-thread`
/// marks them read on fetch).
model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderRole     MessageSenderRole
  senderUserId   String
  content        String
  isRead         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// Médias (MinIO) — packages/storage
// ============================================================

model Media {
  id           String          @id @default(cuid())
  bucket       String
  objectKey    String
  url          String
  altText      String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  entityType   MediaEntityType
  entityId     String?
  sortOrder    Int             @default(0)
  uploadedById String?
  createdAt    DateTime        @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  creationRefs         Creation[]        @relation("CreationMedia")
  productRefs          Product[]         @relation("ProductMedia")
  productVariantRefs   ProductVariant[]  @relation("ProductVariantMedia")
  collectionRefs       Collection[]      @relation("CollectionMedia")
  atelierRefs          Atelier[]         @relation("AtelierMedia")
  blogPostRefs         BlogPost[]        @relation("BlogPostMedia")
  testimonialRefs      Testimonial[]     @relation("TestimonialMedia")
  patternInspirationOf PatternProject[]  @relation("PatternInspirationMedia")
  patternExportOf      PatternExport[]   @relation("PatternExportMedia")
  pageSectionRefs      PageSection[]     @relation("PageSectionMedia")

  @@unique([bucket, objectKey])
  @@index([entityType, entityId])
  @@map("media")
}

// ============================================================
// Gestion de contenu (back-office) — docs/pages/admin-gestion-contenu.md
// ============================================================

model PageSection {
  id                String        @id @default(cuid())
  page              String // e.g. "accueil"
  sectionKey        String // e.g. "hero"
  locale            Locale        @default(FR)
  titleText         String?
  subtitleText      String?
  bodyText          String?
  ctaPrimaryLabel   String?
  ctaSecondaryLabel String?
  dataJson          Json?
  mediaId           String?
  status            ContentStatus @default(DRAFT)
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  media     Media?               @relation("PageSectionMedia", fields: [mediaId], references: [id])
  versions  PageSectionVersion[]

  @@unique([page, sectionKey, locale])
  @@map("page_sections")
}

model PageSectionVersion {
  id            String   @id @default(cuid())
  pageSectionId String
  snapshotJson  Json
  editedById    String?
  createdAt     DateTime @default(now())

  pageSection PageSection @relation(fields: [pageSectionId], references: [id], onDelete: Cascade)
  editedBy    User?       @relation(fields: [editedById], references: [id])

  @@index([pageSectionId])
  @@map("page_section_versions")
}
