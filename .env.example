# =============================================================================
# ANGALY — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- Database (Postgres 16 via Prisma) ---
DATABASE_URL="postgresql://angaly_user:angaly_pass@localhost:5432/angaly_dev"
DATABASE_SHADOW_URL="postgresql://angaly_user:angaly_pass@localhost:5432/angaly_shadow"

# PostgreSQL Docker (used by docker-compose)
POSTGRES_USER="angaly_user"
POSTGRES_PASSWORD="angaly_pass"
POSTGRES_DB="angaly_dev"

# --- JWT RS256 (apps/api) ---
# Générer avec: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Encoder en base64: base64 -w0 private.pem
JWT_PRIVATE_KEY_BASE64="..."
JWT_PUBLIC_KEY_BASE64="..."
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# --- NextAuth v5 (Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# --- API URLs ---
NEXT_PUBLIC_API_URL="http://localhost:3003/api"
NEXT_PUBLIC_WS_URL="ws://localhost:3003"
API_PORT=3003
# Server-side URL the web container uses to reach the api container directly
# (e.g. NextAuth's authorize() callback). In prod compose this is the api
# service's internal network name, e.g. http://api:3003/api.
API_INTERNAL_URL="http://localhost:3003/api"

# --- AI Service (apps/ai-service, FastAPI) ---
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_INTERNAL_URL="http://ai-service:8000"
AI_SERVICE_PORT=8000
AI_SERVICE_TIMEOUT_MS=15000

# --- MinIO (S3-compatible object storage for all media) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER="angaly_minio"
MINIO_ROOT_PASSWORD="changeme-minio-root-password"
MINIO_ACCESS_KEY="angaly_minio"
MINIO_SECRET_KEY="changeme-minio-root-password"
# Buckets (spec §76) — created automatically by the minio-init compose step
MINIO_BUCKET_CREATIONS="creations"
MINIO_BUCKET_PRODUCTS="products"
MINIO_BUCKET_COLLECTIONS="collections"
MINIO_BUCKET_ATELIERS="ateliers"
MINIO_BUCKET_CUSTOMERS="customers"
MINIO_BUCKET_PATTERNS="patterns"
MINIO_BUCKET_BLOG="blog"
MINIO_BUCKET_AVATARS="avatars"
MINIO_BUCKET_QUOTES="quotes"
# Public base URL used to build served image URLs (behind Caddy/Nginx in prod)
MINIO_PUBLIC_URL="http://localhost:9000"

# --- Redis (sessions/cache, introduced when a feature needs it) ---
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# --- NestJS ---
NODE_ENV="development"
API_CORS_ORIGINS="http://localhost:3000"

# --- i18n ---
DEFAULT_LOCALE="fr"
SUPPORTED_LOCALES="fr,mg"
